# =============================================================================
# Nothing generated belongs in this repository. Everything below is reproducible
# from source via create_vivado_project.tcl / build_all.tcl / tb/run_all_tb.sh,
# so committing it only adds weight and lets the working copy and the repository
# drift apart.
# =============================================================================

# ---- Vivado projects and build products ----
*.xpr
*.xsa
*.bit
*.dcp
*.ltx
*.mmi
*.rpt
vivado/
vivado_*/
.Xil/
.metadata/
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.srcs/
*.gen/
dfx_runtime.txt
webtalk*
usage_statistics_webtalk.html

# ---- xsim simulation artefacts ----
# What tb/run_all_tb.sh leaves behind on every run.
xsim.dir/
*.wdb
*.vcd
*.fst
*.wlf
*.pb
*.vds
xsimcrash.log
transcript

# ---- logs and crash dumps ----
*.log
*.jou
*.str
hs_err_pid*
replay_pid*
javacore.*
*.dmp

# ---- test inputs and outputs ----
# ITCH captures are exchange data, not source. Golden and simulation CSVs are
# regenerated by tb/run_diff.sh - a stale CSV carrying no record of the
# parameters that produced it is worse than no CSV at all.
*.bin
golden_*.csv
sim_frames*.csv
hw_*.csv
diff_input.bin

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- third-party reference material ----
# doc/ holds published vendor factsheets and academic papers kept locally for
# reference. They are other people's copyrighted work, not this project's
# source, so they are not redistributed here. docs/ (this project's own
# documentation) is deliberately NOT covered by this rule.
doc/
